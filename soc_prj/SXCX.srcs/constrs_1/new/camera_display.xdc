# Screenshot pins. External RST=3V3, PWDN=GND.
set_property PACKAGE_PIN AE28 [get_ports {camera_xclk}]
set_property PACKAGE_PIN AF28 [get_ports {camera_pclk}]
set_property PACKAGE_PIN AJ28 [get_ports {camera_vsync}]
set_property PACKAGE_PIN AJ29 [get_ports {camera_href}]
set_property PACKAGE_PIN AJ30 [get_ports {camera_data[0]}]
set_property PACKAGE_PIN AG27 [get_ports {camera_data[1]}]
set_property PACKAGE_PIN AG26 [get_ports {camera_data[2]}]
set_property PACKAGE_PIN AF25 [get_ports {camera_data[3]}]
set_property PACKAGE_PIN AK30 [get_ports {camera_data[4]}]
set_property PACKAGE_PIN AE25 [get_ports {camera_data[5]}]
set_property PACKAGE_PIN AK26 [get_ports {camera_data[6]}]
set_property PACKAGE_PIN AJ26 [get_ports {camera_data[7]}]
set_property PACKAGE_PIN AH29 [get_ports {camera_scl}]
set_property PACKAGE_PIN AH28 [get_ports {camera_sda}]
set_property PACKAGE_PIN U26 [get_ports {hdmi_clk_p}]
set_property PACKAGE_PIN U27 [get_ports {hdmi_clk_n}]
set_property PACKAGE_PIN W29 [get_ports {hdmi_d_p[0]}]
set_property PACKAGE_PIN W30 [get_ports {hdmi_d_n[0]}]
set_property PACKAGE_PIN T25 [get_ports {hdmi_d_p[1]}]
set_property PACKAGE_PIN T24 [get_ports {hdmi_d_n[1]}]
set_property PACKAGE_PIN R27 [get_ports {hdmi_d_p[2]}]
set_property PACKAGE_PIN T27 [get_ports {hdmi_d_n[2]}]

set_property IOSTANDARD LVCMOS33 [get_ports {camera_*}]
set_property DRIVE 8 [get_ports {camera_xclk camera_scl camera_sda}]
set_property SLEW SLOW [get_ports {camera_xclk camera_scl camera_sda}]
set_property PULLUP true [get_ports {camera_scl camera_sda}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_*}]
# AF28 is an N-side clock pad; single-ended use requires non-dedicated routing.
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets camera_pclk_IBUF]
create_clock -name camera_pclk -period 15.000 [get_ports camera_pclk]
# Engineering budget, not an on-board measurement. DVP launches on falling edge.
set_input_delay -clock camera_pclk -clock_fall -min 0.500 [get_ports {camera_data[*] camera_vsync camera_href}]
set_input_delay -clock camera_pclk -clock_fall -max 5.000 [get_ports {camera_data[*] camera_vsync camera_href}]
set_clock_groups -asynchronous -group [get_clocks camera_pclk] -group [get_clocks -include_generated_clocks sys_clk]
set_false_path -to [get_cells -hier -filter {NAME =~ *status_meta_reg*}]
set_false_path -to [get_pins -hier -filter {NAME =~ *pixel_reset_sync_reg*/CLR || NAME =~ *camera_reset_sync_reg*/CLR}]
